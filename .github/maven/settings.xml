<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the workflows of this repository give Maven.

  Two servers. Both read their credentials from environment variables, which only the step
  that publishes sets:
  - 'vanillabp-central' is the Central Portal, for the snapshot repository of Maven Central.
  - 'github-packages' is GitHub Packages of this repository. The GITHUB_TOKEN of the run may
    write there, because the job asks for 'packages: write'.
  The profile 'publish-snapshots' of the POM uses both.

  This repository reads no snapshot of another VanillaBP repository, so there is nothing to
  read from GitHub Packages here. The repositories which do read them have a profile for it
  in their own copy of this file.

  The file lives outside .github/workflows on purpose: a change to a workflow file needs a
  token with a special scope, a change here does not.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>vanillabp-central</id>
            <username>${env.MAVEN_USERNAME}</username>
            <password>${env.MAVEN_PASSWORD}</password>
        </server>
        <server>
            <id>github-packages</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
</settings>
