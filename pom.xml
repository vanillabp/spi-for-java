<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>release-parent</artifactId>
    <version>1.2.1</version>
  </parent>

  <artifactId>spi-for-java</artifactId>
  <version>2.0.0-SNAPSHOT</version>

  <name>VanillaBP SPI for Java</name>
  <description>VanillaBP is an independent API for business processing engines kept simply, plain and without frills.</description>
  <url>https://www.vanillabp.io</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>VanillaBP</id>
      <organization>Phactum Softwareentwicklung GmbH</organization>
      <organizationUrl>https://www.phactum.at</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/vanillabp/spi-for-java.git</connection>
    <developerConnection>scm:git:https://github.com/vanillabp/spi-for-java.git</developerConnection>
    <url>http://github.com/vanillabp/spi-for-java/tree/main</url>
  </scm>

  <distributionManagement>
    <snapshotRepository>
      <id>github</id>
      <name>Github Packages</name>
      <url>https://maven.pkg.github.com/vanillabp/spi-for-java</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <version.java>21</version.java>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>${version.java}</release>
            <compilerArgs>
              <!-- this repository is API and nothing else, so its javadoc is read twice.
                   javac sees every class, the package private ones too, and that is where
                   the plugin below never looks: it stops at protected, because that is what
                   the published documentation shows. Every group is on except 'missing'. A
                   comment nobody has written yet stays a warning, which is the line the
                   plugin draws as well. -->
              <arg>-Xdoclint:all,-missing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <configuration>
            <!-- a warning fails the build here. Everything in this repository is API an
                 application reads, so a comment nobody wrote is a gap for its author. The
                 gaps here were written once, and a warning which passes parks the next one
                 in a build which looks green. Everything else about the check comes from
                 the parent. -->
            <failOnWarnings>true</failOnWarnings>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
        <configuration>
          <pom>
            <includes>
              <include>**/pom.xml</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <sortPom>
              <quiet>true</quiet>
            </sortPom>
          </pom>
          <markdown>
            <includes>
              <include>**/*.md</include>
            </includes>
            <excludes>
              <exclude>**/target/**/</exclude>
              <exclude>**/node_modules/**/</exclude>
              <!-- the workflows carry comments, and the YAML formatter round-trips
                   through Jackson, which drops them -->
              <exclude>**/.github/**/</exclude>
            </excludes>
            <flexmark/>
          </markdown>
          <java>
            <eclipse>
              <!-- https://help.eclipse.org/latest/index.jsp?topic=%2Forg.eclipse.jdt.doc.isv%2Freference%2Fapi%2Forg%2Feclipse%2Fjdt%2Fcore%2Fformatter%2FDefaultCodeFormatterConstants.html -->
              <file>${maven.multiModuleProjectDirectory}/formatting_conventions.xml</file>
              <version>4.35</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,org,com,at.phactum</order>
            </importOrder>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
